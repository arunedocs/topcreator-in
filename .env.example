# MongoDB Atlas
# The database name is part of the URI path and must match MONGODB_DB_NAME.
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/top-creater?retryWrites=true&w=majority"
MONGODB_DB_NAME="top-creater"

# Razorpay test keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxx"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin dashboard (/admin). Required in production.
ADMIN_PASSWORD="change-me"
# Optional extra secret for creator claim cookies
OWNERSHIP_SECRET="change-me-too"
