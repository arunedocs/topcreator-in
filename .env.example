# Neon (free PostgreSQL): https://neon.tech
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Razorpay test keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxx"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin dashboard (/admin). Required in production.
ADMIN_PASSWORD="change-me"
# Optional extra secret for creator claim cookies
OWNERSHIP_SECRET="change-me-too"
